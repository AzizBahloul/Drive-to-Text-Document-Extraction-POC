# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Google Drive API key (API key only, no OAuth). Create one in Google Cloud Console
# with the "Google Drive API" enabled. Without it the app falls back to reading the
# public folder page, which works for small folders but reports no file sizes.
GOOGLE_API_KEY=

# Private Drive uses a Google OAuth web client ID. Add the app origin in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
# To enable Google Picker, set its browser API key and numeric Google Cloud project number.
GOOGLE_PICKER_KEY=
GOOGLE_PROJECT_NUMBER=

# Largest file the app will download, in megabytes.
MAX_FILE_SIZE_MB=25

# Concurrent Drive downloads and concurrent extraction workers.
MAX_PARALLEL_DOWNLOADS=4
MAX_PARALLEL_FILES=2

# Tesseract language(s) used by default. Combine with "+", e.g. fra+eng.
OCR_DEFAULT_LANGUAGE=eng

# Resolution used when a scanned PDF page is rendered before OCR.
OCR_RENDER_DPI=300

# A PDF page with fewer readable characters than this is treated as scanned and sent to OCR.
PDF_TEXT_MIN_CHARS_PER_PAGE=25

# Path to the tesseract binary if it is not on PATH.
TESSERACT_CMD=tesseract
# Folder of language packs (*.traineddata) when they are not in the system folder, e.g. to
# add fra/ara without root. Unset: Tesseract's own folder.
# TESSDATA_DIR=/home/you/.local/share/tessdata

# Safety limits for files coming from a folder you do not control.
# Seconds Tesseract may spend on one image or one scanned PDF page before it is stopped.
OCR_TIMEOUT_SECONDS=60
# Scanned pages of one PDF OCR'd in parallel. 0 picks a value from the CPU count
# (cores / MAX_PARALLEL_FILES, between 1 and 4).
OCR_PAGE_WORKERS=0
# Pages read per PDF; later pages are skipped with a warning.
MAX_PDF_PAGES=2000
# Seconds one file may take in total; the pages done so far are kept, with a warning.
FILE_TIME_LIMIT_SECONDS=900
# Subfolder levels listed below the shared folder (0 = top level only), and the most
# folders read per listing, the shared one included.
SUBFOLDER_DEPTH=3
MAX_FOLDERS=50
# Batches allowed to run at the same time; extra requests get HTTP 429.
MAX_RUNNING_BATCHES=4
# Finished batches kept in memory (with their text) before the oldest are dropped.
BATCH_RETENTION=50

# Host headers the server answers to (protects the local API against DNS rebinding).
# Add your machine's name or IP if you open the app from another device; "*" disables it.
ALLOWED_HOSTS=localhost,127.0.0.1

# Server binding.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
